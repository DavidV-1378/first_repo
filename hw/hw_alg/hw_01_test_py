def test_longer_than_five_ordinary():
    assert longer_than_five(["cat", "pigeon", "dog"]) == "pigeon"


def test_longer_than_five_empty():
    assert longer_than_five([]) is None


def test_longer_than_five_first_match():
    assert longer_than_five(["pineapple", "watermelon", "grapefruit"]) == "pineapple"


